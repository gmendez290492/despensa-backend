# Configuración local de ejemplo (copiar a .env, nunca subir .env real a Git)
APP_NAME="Despensa API"
ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://despensa:despensa_dev_pass@postgres:5432/despensa

# RabbitMQ (coincide con docker-compose.yml)
RABBITMQ_URL=amqp://despensa:despensa_dev_pass@rabbitmq:5672/

# Mailpit SMTP local
SMTP_HOST=mailpit
SMTP_PORT=1025
