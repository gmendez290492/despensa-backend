# Configuración local de ejemplo (copiar a .env, nunca subir .env real a Git)
APP_NAME="Despensa API"
ENVIRONMENT=local
LOG_LEVEL=INFO

# PostgreSQL (coincide con docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://despensa:despensa_dev_pass@postgres:5432/despensa

# RabbitMQ (coincide con docker-compose.yml)
RABBITMQ_URL=amqp://despensa:despensa_dev_pass@rabbitmq:5672/

# Mailpit SMTP local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@despensa.local

# Seguridad JWT (en dev/prod usar secreto aleatorio >= 32 caracteres vía Secrets Manager)
JWT_SECRET_KEY=local-dev-only-secret-key-change-in-production-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
